  "findings": [
    {
      "id": "F1",
      "kind": "reduction",
      "claim": "g(k) <= 2 + N(k+1), where N(r) is the maximum number of solutions of x+y=1 with x,y in a rank-r subgroup of Q^*. Unconditionally g(k) <= 2 + 2^{8k+16} via Beukers-Schlickewei.",
      "status": "proved (elementary, given the cited counting theorem); not new",
      "consequence": "N(r) = exp(o(r)) implies Erdos #126.",
      "direction_check": "one-way: a LOWER bound on N (Erdos-Stewart-Tijdeman) does not refute #126."
    },
    {
