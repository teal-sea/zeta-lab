/-- **The three-point certificate.**  This is the hypothesis `hCert` of
`Zeta23Ext.Bridge.n_point_bound` at `n = 3`, `c = 1345/10⁶`, `p = 3000`, proved. -/
theorem three_point_cert :
    ∀ g : Fin (3-1) → ℝ, (∀ i, 0 ≤ g i) → (1345/1000000:ℝ) ≤ F 3 3000 g := by
  intro g hg
  rw [F3_eq]
  have hx0 : (0:ℝ) ≤ g 0 := hg 0
  have hy0 : (0:ℝ) ≤ g 1 := hg 1
  set x : ℝ := g 0 with hxd
  set y : ℝ := g 1 with hyd
  have hn0 := wfun_nonneg x
  have hn1 := wfun_nonneg y
  have hn2 := wfun_nonneg (x+y)
  rcases le_total (807/200:ℝ) (x + y) with hS | hS
  · linarith
  have hxS : x ≤ (807/200:ℝ) := by linarith
  have hyS : y ≤ (807/200:ℝ) := by linarith
  rcases cover1 x hx0 hxS with hcx | hbx
  · linarith
  rcases cover1 y hy0 hyS with hcy | hby
  · linarith
  rcases hbx with hbx0 | hbx1 | hbx2 | hbx3
  all_goals (rcases hby with hby0 | hby1 | hby2 | hby3)
  · exact pair_0_0 x y hbx0.1 hbx0.2 hby0.1 hby0.2
  · exact pair_0_1 x y hbx0.1 hbx0.2 hby1.1 hby1.2
  · exact pair_0_2 x y hbx0.1 hbx0.2 hby2.1 hby2.2
  · exfalso; linarith [hbx0.1, hby3.1]
  · have h := pair_0_1 y x hby0.1 hby0.2 hbx1.1 hbx1.2
    rw [show y + x = x + y from by ring] at h
    linarith
  · exact pair_1_1 x y hbx1.1 hbx1.2 hby1.1 hby1.2
  · exfalso; linarith [hbx1.1, hby2.1]
  · exfalso; linarith [hbx1.1, hby3.1]
  · have h := pair_0_2 y x hby0.1 hby0.2 hbx2.1 hbx2.2
    rw [show y + x = x + y from by ring] at h
    linarith
  · exfalso; linarith [hbx2.1, hby1.1]
  · exfalso; linarith [hbx2.1, hby2.1]
  · exfalso; linarith [hbx2.1, hby3.1]
  · exfalso; linarith [hbx3.1, hby0.1]
  · exfalso; linarith [hbx3.1, hby1.1]
  · exfalso; linarith [hbx3.1, hby2.1]
  · exfalso; linarith [hbx3.1, hby3.1]

/-- `Phi_n 3 c m p` at the certificate's parameters, as an exact rational in `HD 1`. -/
theorem Phi_three : Phi_n 3 (1345/1000000:ℝ) 745 3000 = (149000000 * HD 1 - 99200) / 148800133 := by
  unfold Phi_n
  push_cast
  -- `1 − c(m−(n−1))/m` and the right denominator are nonzero rationals, so the
  -- identity is a single cross-multiplication with `HD 1` left as an atom.
  rw [div_eq_div_iff (by norm_num) (by norm_num)]
  ring

/-- **The three-point bound, unconditional.**  `Zeta23Ext.Bridge.n_point_bound` at
`n = 3` with its certificate hypothesis discharged by `three_point_cert`: for Mathlib's
`riemannZeta`, for every `ε > 0` and all large `T`, `(Φ₃ − ε) N(T,2T) ≤ N₀ˢ(T,2T)` with
`Φ₃ = (149000000 H − 99200)/148800133`, `H = HD 1 = 3/2 − (1/√2)cot(1/√2)`. -/
theorem three_point_bound :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      ((149000000 * HD 1 - 99200) / 148800133 - ε) * (Ncount T (2 * T) : ℝ)
        ≤ N0simple T (2 * T) := by
  rw [← Phi_three]
  exact n_point_bound 3 (1345/1000000:ℝ) 745 3000 (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) three_point_cert (by norm_num)

/-- **The same bound as a proportion.** -/
theorem three_point_bound_ratio :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (149000000 * HD 1 - 99200) / 148800133 - ε
        ≤ (N0simple T (2 * T) : ℝ) / (Ncount T (2 * T) : ℝ) := by
  intro ε hε
  obtain ⟨T₁, hT₁⟩ := three_point_bound ε hε
  obtain ⟨T₂, hT₂⟩ := eventually_atTop.mp eventually_Ncount_pos
  refine ⟨max T₁ T₂, fun T hT => ?_⟩
  have h1 := hT₁ T (le_trans (le_max_left _ _) hT)
  have h2 := hT₂ T (le_trans (le_max_right _ _) hT)
  rw [le_div_iff₀ h2]
  exact h1

