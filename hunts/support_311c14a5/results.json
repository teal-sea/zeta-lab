{
  "hunt": "support_311c14a5",
  "arm": "additive-combinatorics",
  "note": "Nothing here is evidence for or against RH (docs/08).",
  "findings": {
    "reduction": {
      "statement": "A admissible for S, |A|=n>=3, a!=b in A, d=a-b. Then c -> (a+c, b+c) injects A\\{a,b} into the solutions of (1/d)X + (-1/d)Y = 1 with X,Y S-units. Hence g(k) <= 2 + E(k).",
      "E_of_k": "max over k-prime sets S and nonzero rationals alpha,beta of the number of solutions of alpha*X + beta*Y = 1 in S-units",
      "rank_used": "k (constants live in the coefficients, not the group)",
      "grade": "proved, elementary; mechanics re-verified on all 7 witnesses"
    },
    "narrowest_upgrade": {
      "target": "E(k) = exp(o(k)), uniform in alpha,beta",
      "sub_target": "exp(o(k)) bound on the number of pairs of positive S-units differing by a fixed d, uniform in d",
      "implies": "log g(k) = o(k), i.e. Erdos #126",
      "converse_holds": false
    },
    "quantitative_today": {
      "evertse_1984_upper": "E(k) <= exp(4(k+1)+6) = exp(4k+10)",
      "beukers_schlickewei_1996_upper": "rank-r x+y=1: <= 2^(8(r+2))",
      "erdos_stewart_tijdeman_1988_lower": "E(k) >= exp((4+o(1))*sqrt(k/log k))",
      "erdos_turan_1934": "g(k) < 3*2^(k-1)",
      "verdict": "unit-equation route is currently much weaker than 1934 (base e^4 vs base 2); its lower-bound floor is exp(o(k)) and therefore does not obstruct the target"
    },
    "tools_reported_inapplicable": {
      "freiman": "needs small doubling; admissible sets have maximal doubling",
      "sum_product": "multiplicative structure sits on A+A, not on A",
      "additive_energy": "Cauchy-Schwarz gives n <= 2*Psi(2N,p_k), dominated by the trivial per-row count n-1 <= Psi(2N,p_k); both are N-dependent"
    },
    "audit_of_r_186989": {
      "witnesses_confirmed": true,
      "g_N_3_independently_reproduced": true,
      "sharpening": "a composition law g(k1+k2)>=g(k1)g(k2) forces g(k)=2^k exactly, via Fekete plus the Erdos-Turan upper bound; testable at k=3, which would need an 8-element admissible set",
      "correction": "loose thread 3 is false: the mod-2 cap |A|<=2 does not generalise to odd p, because A may sit entirely in one nonzero class mod p"
    }
  },
