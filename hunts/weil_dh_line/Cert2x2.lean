/-
Pipeline smoke test for the Davenport-Heilbronn certificate route: the
principal 2 x 2 block at modes (54, 55) of the band N = 64 even DH Gram at
window c = 55. Generated by `gen_cert_lean.py`; data in `cert_data.json`.

With `w = (d, -b)` the block's form is `d (a d - b^2)`, negative here. At c = 55
the form's lowest eigenvalue is far below zero; this is far from the 30.6 to 30.8
threshold and says nothing about the cell. It exercises the same generator,
data path and kernel check as `Cert65.lean` at a size that checks in seconds.
The same scope applies: the Arb enclosure and the perturbation inequality are
not formalized here.
-/
module

@[expose] public section

namespace ZetaLab.DHSmoke2x2

/-- Dot product of two integer lists. -/
def dot (x y : List Int) : Int := (List.zipWith (· * ·) x y).foldl (· + ·) 0

/-- The quadratic form `u^T B u`, with `B` given by its rows. -/
def qf (B : List (List Int)) (u : List Int) : Int := dot u (B.map (fun row => dot row u))

set_option maxHeartbeats 2000000 in
def row0 : List Int := [31103271688505081125159639407567424241478732085557475447922473001014584817973, -92776165202690759339519621866470968260106160554965592145775191025917715918243]

set_option maxHeartbeats 2000000 in
def row1 : List Int := [-92776165202690759339519621866470968260106160554965592145775191025917715918243, 167813748152990020249179345159555574499551883044527046048865530958426841840988]

/-- `L` times the exact Arb midpoints of the Gram entries (`L = 28948022309329048855892746252171976963317496166410141009864396001978282409984`), by rows. -/
def B : List (List Int) := [row0, row1]

/-- The test vector. -/
def u : List Int := [167813748152990020249179345159555574499551883044527046048865530958426841840988, 92776165202690759339519621866470968260106160554965592145775191025917715918243]

/-- An upper bound for the largest row sum of the Arb entry radii, `eNum / eDen`. -/
def eNum : Int := 92279323
def eDen : Int := 474284397516047136454946754595585670566993857190463750305618264096412179005177856
def L : Int := 28948022309329048855892746252171976963317496166410141009864396001978282409984

/-- `B` is a symmetric `2 x 2` array and `u` has `2` entries. -/
def shapeOK : Bool :=
  B.length == 2 && B.all (fun row => row.length == 2) && u.length == 2 &&
    (List.range 2).all (fun i => (List.range 2).all (fun j =>
      (B.getD i []).getD j 0 == (B.getD j []).getD i 0))

theorem shape_ok : shapeOK = true := by decide +kernel

/-- The integer quadratic form of the midpoint matrix is negative at `u`. -/
theorem qf_neg : qf B u < 0 := by decide +kernel

/-- The margin: `u^T mid(M) u / u^T u + eNum / eDen < 0`, cleared of denominators. -/
theorem margin_neg : eDen * qf B u + eNum * L * dot u u < 0 := by decide +kernel

#print axioms shape_ok
#print axioms qf_neg
#print axioms margin_neg

end ZetaLab.DHSmoke2x2
