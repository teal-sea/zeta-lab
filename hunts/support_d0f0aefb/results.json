{
  "arm": "graph-ramsey",
  "claims": [
    {
      "checked_by": "parity_bound",
      "grade": "proved",
      "id": "P",
      "statement": "2 not in S implies |A| <= 2."
    },
    {
      "checked_by": "witness_audit[*].per_prime",
      "grade": "proved",
      "id": "T1",
      "statement": "G_p is the disjoint union of G_p|V_0 and a complete multipartite join of the level sets V_t, t>=1; for odd p each G_p|V_t is a disjoint union of complete bipartite graphs, for p=2 each is a clique. chi(G_p) <= 2 T_p for odd p."
    },
    {
      "checked_by": "coprime_subproblem",
      "grade": "proved",
      "id": "T2",
      "statement": "If every a in A is coprime to prod S then |A| <= 2^k. Sharper than the Erdos-Turan 3*2^(k-1) on that sub-family."
    },
    {
      "checked_by": "residue_cover_unbounded",
      "grade": "proved",
      "id": "T3",
      "statement": "For every n there is A with |A|=n, gcd(A)=1, and k=2 primes whose graphs G_p cover K_n. Hence no bound on n follows from the cover structure alone."
    },
    {
      "checked_by": "s_unit_reduction",
      "grade": "proved",
      "id": "T4",
      "statement": "g(k) <= 3 + N_3(k), N_3 = max number of nondegenerate solutions of x+y+z=1 in S-units of Q with |S|=k. One-directional: N_3(k)=exp(o(k)) implies Erdos #126; not conversely."
    },
    {
      "checked_by": "p_not_in_S_thread",
      "grade": "refutation",
      "id": "R1",
      "statement": "r_186989 loose thread '|A| <= p-1 when p not in S' is false for odd p. Witness {1,4,124}, S={2,5}, p=3."
    }
  ],
