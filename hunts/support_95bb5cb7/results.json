{
  "run_id": "95bb5cb7-15fe-44ef-bddf-453e791d2946",
  "arm": "size-dichotomy",
  "question": "Does a large-gap/controlled-interval dichotomy give log g(k)=o(k) for Erdos 126?",
  "verdict": "not-settled-for-the-conjecture; settled-negative-for-the-arm",
  "headline": "The controlled-interval horn works iff max(A)=rad(S)^{o(1)}; the spread-out horn cannot supply that, and even an abc-optimal height bound would land at rad(S)^{1+o(1)}, one full power of rad above the threshold.",
  "lemma_1_counting_step": {
    "statement": "|A| <= 1 + Psi(2N,S) with N=max A; the n-1 sums a_j+max(A) are distinct S-smooth integers in (N, N+a_{n-1}] subset (N,2N].",
    "refinements_tried": [
      "dyadic block Psi(2N)-Psi(N)",
      "short interval (N, N+a_{n-1}]"
    ],
    "refinement_effect": "none at logarithmic scale"
  },
  "lemma_2_threshold": {
    "statement": "With log 2N = c*theta(p_k), log Psi(2N,S)/k -> 0 iff c -> 0. Equivalently the horn needs max A = rad(S)^{o(1)}.",
    "upper_bound_method": "Rankin, Psi(x,S) <= x^sigma prod_p (1-p^-sigma)^-1, sigma optimised numerically",
    "lower_bound_method": "simplex lattice-point count >= volume (log x)^k/(k! prod log p_i)",
