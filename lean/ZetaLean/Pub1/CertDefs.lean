  | 19 => (1048576/155815096120119939628125)
  | 20 => (524288/1599154933864388854078125)
  | _ => 0

/-- The exact rational trial polynomial `u(t) = ∑_{j=0}^5 c_j t^(2j)`. -/
noncomputable def uPoly (t : ℝ) : ℝ := ∑ j ∈ range 6, cK j * t ^ (2 * j)

/-- The `M = 20` truncation of the Farmer-Gonek-Lee kernel. -/
noncomputable def truncKernel (x : ℝ) : ℝ :=
  -4 * x ^ 2 + ∑ k ∈ range 21, aK k * |x| ^ (2 * k + 1)

/-- The atomic integral `∫_I |x-t|^m t^n dt`. -/
noncomputable def atomInt (m n : ℕ) (x : ℝ) : ℝ :=
  ∫ t in (-(1:ℝ)/2)..(1/2), |x - t| ^ m * t ^ n

