/-- An explicit antiderivative of `r₀²`. -/
noncomputable def r0sqAnti (x : ℝ) : ℝ := ∑ d ∈ range 106, r0sqAntiCoeff d * x ^ d

set_option maxHeartbeats 4000000 in
theorem r0Poly_sq (x : ℝ) : r0Poly x ^ 2 = ∑ d ∈ range 105, r0sqCoeff d * x ^ d := by
  simp only [r0Poly, r0sqCoeff, Finset.sum_range_succ, Finset.sum_range_zero]
  ring

set_option maxHeartbeats 4000000 in
theorem hasDerivAt_r0sqAnti (x : ℝ) : HasDerivAt r0sqAnti (r0Poly x ^ 2) x := by
  have h := hasDerivAt_sumPow r0sqAntiCoeff 105 x
  rw [r0Poly_sq]
  refine h.congr_deriv ?_
  simp only [r0sqAntiCoeff, r0sqCoeff, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

set_option maxHeartbeats 4000000 in
/-- **The exact `L²` norm squared of the residual.** -/
theorem integral_r0_sq :
    (∫ x in (-(1:ℝ)/2)..(1/2), r0Poly x ^ 2) = () := by
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hasDerivAt_r0sqAnti x)]
  · simp only [r0sqAnti, r0sqAntiCoeff, Finset.sum_range_succ, Finset.sum_range_zero]
    norm_num
  · apply Continuous.intervalIntegrable
    have : Continuous r0Poly := by
      unfold r0Poly; fun_prop
    exact this.pow 2

/-- `‖r₀‖₂` is below the exact rational upper bound used by the certificate. -/
theorem r0_l2_le :
    Real.sqrt (∫ x in (-(1:ℝ)/2)..(1/2), r0Poly x ^ 2) ≤ () := by
  rw [integral_r0_sq]
  rw [show (() : ℝ)
      = Real.sqrt ((() : ℝ) ^ 2) by
    rw [Real.sqrt_sq (by norm_num)]]
  apply Real.sqrt_le_sqrt
  norm_num

