import Mathlib
import ZetaLean.Pub1.Numeric

/-!
# Pub 1 strong closure: the certificate arithmetic

Every constant of `admissible_closure.py` as an exact rational, and the single
inequality the strict-concavity argument reduces to.  Kernel-checked; the final
margin is about `3.6e-13`.

`gl2sqC` bounds `∫_I (r₀ - Eu)²` without Minkowski, by expanding the square and
using `|Eu| ≤ eC` together with `∫|r₀| ≤ r0C`.
-/

namespace ZetaLean.Pub1

/-- `R0` -/
def r0C : ℚ := (22534194874750966043605394052916506697717808709968901166642054114038013/1037925212884596544329873211241309317368812156699694915247615666054968115200)

/-- `R2` -/
def r2C : ℚ := (4442478353514913796149496230394754552708994598651381896302690306512880839/742563253265651144924646013079004491020498624012487777048717709803520000000)

/-- `RHO` -/
def rhoC : ℚ := (45088768/2828846926917599723269509375)

/-- `ST` -/
def stC : ℚ := (666953056256/23065890935073171953452059375)

/-- `QABS` -/
def qabsC : ℚ := (622490816315301203923339889968/7688630311691057317817353125)

/-- `USUP` -/
def usupC : ℚ := (30332356197818195983072014291785813/23875752649136778349932752439813120)

/-- `E` -/
def eC : ℚ := (1335594308102330805526626933295912918016/65957860848979800793407990452361799469212031724462420984375)

/-- `BG` -/
def bgC : ℚ := (1591477513029288461166654297624528362602664818315066864650732786638140110173/73303468159974630943297295543917470539172358566915953389362856415132123136000000)

/-- `GL2SQ` -/
def gl2sqC : ℚ := ()

/-- `GL2` -/
def gl2C : ℚ := ()

/-- `ZINF` -/
def zinfC : ℚ := (1591477513029288461166654297624528362602664818315066864650732786638140110173/40724148977763683857387386413287483632873532537175529660757142452851179520000000)

/-- `ZL2` -/
def zl2C : ℚ := ()

/-- `R0L2SQ` -/
def r0l2sqC : ℚ := ()

theorem eC_eq : eC = rhoC * usupC := by norm_num [eC, rhoC, usupC]

theorem bgC_eq : bgC = r0C + eC := by norm_num [bgC, r0C, eC, rhoC, usupC]

theorem gl2sqC_eq : gl2sqC = r0l2sqC + 2 * eC * r0C + eC * eC := by
  norm_num [gl2sqC, r0l2sqC, eC, r0C, rhoC, usupC]

theorem gl2C_sq_ge : gl2sqC ≤ gl2C * gl2C := by norm_num [gl2sqC, gl2C]

theorem gl2C_nonneg : (0:ℚ) ≤ gl2C := by norm_num [gl2C]

theorem zinfC_eq : zinfC = 9 / 5 * bgC := by norm_num [zinfC, bgC, r0C, eC, rhoC, usupC]

theorem zl2C_eq : zl2C = 9 / 5 * gl2C := by norm_num [zl2C, gl2C]

/-- **The certificate arithmetic closes.** -/
theorem zpp_arith_final :
    r2C + stC * usupC + 2 * zinfC + qabsC * zl2C < 6060899845 / 10 ^ 12 := by
  norm_num [r2C, stC, usupC, zinfC, qabsC, zl2C]

/-- **Strict concavity closes.** -/
theorem concavity_closes_final :
    uSecondDerivBound + (r2C + stC * usupC + 2 * zinfC + qabsC * zl2C) < concavityBound := by
  norm_num [uSecondDerivBound, r2C, stC, usupC, zinfC, qabsC, zl2C, concavityBound, c1]

end ZetaLean.Pub1
