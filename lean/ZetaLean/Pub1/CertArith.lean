/-- `ZL2` -/
def zl2C : ℚ := ()

/-- `ZPP` -/
def zppC : ℚ := ()

/-- **The certificate arithmetic closes.**  With
`‖z''‖_∞ ≤ ‖r₀''‖_∞ + ‖(q-q_M)*u‖_∞ + 2‖z‖_∞ + ‖q*z‖_∞` and each piece bounded by
the constants above, the total is below the target `0.006060899845`. -/
theorem zpp_arith :
    r2C + stC * usupC + 2 * ((9:ℚ)/5 * (r0C + rhoC * usupC))
        + qabsC * ((9:ℚ)/5 * (r0l2C + rhoC * usupC))
      < 6060899845 / 10 ^ 12 := by
  norm_num [r2C, stC, usupC, r0C, rhoC, qabsC, r0l2C]

/-- The same total, named. -/
theorem zppC_lt : zppC < 6060899845 / 10 ^ 12 := by
  norm_num [zppC]

/-- **Strict concavity closes.**  `u'' ≤ 2c₁` and `‖z''‖_∞ < 0.006060899845`
give `w'' < -0.59326318`. -/
theorem concavity_closes : uSecondDerivBound + zppC < concavityBound := by
  norm_num [uSecondDerivBound, zppC, concavityBound, c1]

end ZetaLean.Pub1
