/-- `r₀` in coefficient-table form. -/
noncomputable def r0Sum (x : ℝ) : ℝ := ∑ d ∈ range 53, r0Coeff d * x ^ d
/-- `r₀'` in coefficient-table form. -/
noncomputable def r0Sum1 (x : ℝ) : ℝ := ∑ d ∈ range 52, r0Coeff1 d * x ^ d
/-- `r₀''` in coefficient-table form. -/
noncomputable def r0Sum2 (x : ℝ) : ℝ := ∑ d ∈ range 51, r0Coeff2 d * x ^ d

set_option maxHeartbeats 2000000 in
/-- The table and the closed form define the same polynomial. -/
theorem r0Poly_eq_sum (x : ℝ) : r0Poly x = r0Sum x := by
  simp only [r0Poly, r0Sum, r0Coeff, Finset.sum_range_succ, Finset.sum_range_zero]
  ring

/-- Termwise bound on `[-1/2, 1/2]`. -/
theorem abs_sumPow_le (c : ℕ → ℝ) (N : ℕ) (x : ℝ) (hx : |x| ≤ 1/2) :
    |∑ d ∈ range N, c d * x ^ d| ≤ ∑ d ∈ range N, |c d| * (1/2) ^ d := by
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum ?_)
  intro d _
  rw [abs_mul, abs_pow]
  exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg x) hx d) (abs_nonneg _)

/-- Differentiating a coefficient-table polynomial. -/
theorem hasDerivAt_sumPow (c : ℕ → ℝ) (N : ℕ) (x : ℝ) :
    HasDerivAt (fun y : ℝ => ∑ d ∈ range (N + 1), c d * y ^ d)
      (∑ d ∈ range N, (c (d + 1) * ((d : ℝ) + 1)) * x ^ d) x := by
  have h : HasDerivAt (fun y : ℝ => ∑ d ∈ range (N + 1), c d * y ^ d)
      (∑ d ∈ range (N + 1), c d * ((d : ℝ) * x ^ (d - 1))) x :=
    HasDerivAt.fun_sum (fun d _ => (hasDerivAt_pow d x).const_mul (c d))
  refine h.congr_deriv ?_
  rw [Finset.sum_range_succ']
  simp only [Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one, CharP.cast_eq_zero, zero_mul,
    mul_zero, add_zero]
  exact Finset.sum_congr rfl (fun d _ => by ring)

set_option maxHeartbeats 2000000 in
/-- `r₀' ` is the coefficient table `r0Coeff1`. -/
theorem hasDerivAt_r0Sum (x : ℝ) : HasDerivAt r0Sum (r0Sum1 x) x := by
  have h := hasDerivAt_sumPow r0Coeff 52 x
  refine h.congr_deriv ?_
  simp only [r0Sum1, r0Coeff, r0Coeff1, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

set_option maxHeartbeats 2000000 in
/-- `r₀''` is the coefficient table `r0Coeff2`. -/
theorem hasDerivAt_r0Sum1 (x : ℝ) : HasDerivAt r0Sum1 (r0Sum2 x) x := by
  have h := hasDerivAt_sumPow r0Coeff1 51 x
  refine h.congr_deriv ?_
  simp only [r0Sum2, r0Coeff1, r0Coeff2, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num

/-- `r₀''` really is the second derivative of the residual polynomial. -/
theorem deriv_deriv_r0Sum (x : ℝ) : deriv (deriv r0Sum) x = r0Sum2 x := by
  have h1 : deriv r0Sum = r0Sum1 := funext fun y => (hasDerivAt_r0Sum y).deriv
  rw [h1]
  exact (hasDerivAt_r0Sum1 x).deriv

/-- The exact sup bound on `r₀`. -/
theorem r0Sum_abs_le (x : ℝ) (hx : |x| ≤ 1/2) : |r0Sum x| ≤ (22534194874750966043605394052916506697717808709968901166642054114038013/1037925212884596544329873211241309317368812156699694915247615666054968115200) := by
  refine le_trans (abs_sumPow_le r0Coeff 53 x hx) ?_
  norm_num [r0Coeff, Finset.sum_range_succ]

/-- The exact sup bound on `r₀''`. -/
theorem r0Sum2_abs_le (x : ℝ) (hx : |x| ≤ 1/2) : |r0Sum2 x| ≤ (4442478353514913796149496230394754552708994598651381896302690306512880839/742563253265651144924646013079004491020498624012487777048717709803520000000) := by
  refine le_trans (abs_sumPow_le r0Coeff2 51 x hx) ?_
  norm_num [r0Coeff2, Finset.sum_range_succ]

/-- `‖r₀‖_∞ < 2.1710808e-5`, the decimal recorded by the evidence document. -/
theorem r0Sum_lt_decimal (x : ℝ) (hx : |x| ≤ 1/2) : |r0Sum x| < 21710809/10^12 := by
  refine lt_of_le_of_lt (r0Sum_abs_le x hx) ?_
  norm_num

/-- `‖r₀''‖_∞ < 0.005982627`, the decimal recorded by the evidence document. -/
theorem r0Sum2_lt_decimal (x : ℝ) (hx : |x| ≤ 1/2) : |r0Sum2 x| < 5982627/10^9 := by
  refine lt_of_le_of_lt (r0Sum2_abs_le x hx) ?_
  norm_num

