/-- **The four-point certificate.**  This is the hypothesis `hCert` of
`Zeta23Ext.Bridge.n_point_bound` at `n = 4`, `c = 2310/10⁶`, `p = 2500`, proved. -/
theorem four_point_cert :
    ∀ g : Fin (4-1) → ℝ, (∀ i, 0 ≤ g i) → (2310/1000000:ℝ) ≤ F 4 2500 g := by
  intro g hg
  rw [F4_eq]
  exact cert_core (g 0) (g 1) (g 2) (hg 0) (hg 1) (hg 2)

/-- `Phi_n 4 c m p` at the certificate's parameters, as an exact rational in `HD 1`. -/
theorem Phi_four : Phi_n 4 (2310/1000000:ℝ) 435 2500 = (906250 * HD 1 - 1085) / 904171 := by
  unfold Phi_n
  push_cast
  -- `1 − c(m−(n−1))/m` and the right denominator are nonzero rationals, so the
  -- identity is a single cross-multiplication with `HD 1` left as an atom.
  rw [div_eq_div_iff (by norm_num) (by norm_num)]
  ring

/-- **The four-point bound, unconditional.**  `Zeta23Ext.Bridge.n_point_bound` at
`n = 4` with its certificate hypothesis discharged by `four_point_cert`: for Mathlib's
`riemannZeta`, for every `ε > 0` and all large `T`, `(Φ₄ − ε) N(T,2T) ≤ N₀ˢ(T,2T)` with
`Φ₄ = (906250 H − 1085)/904171`, `H = HD 1 = 3/2 − (1/√2)cot(1/√2)`. -/
theorem four_point_bound :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      ((906250 * HD 1 - 1085) / 904171 - ε) * (Ncount T (2 * T) : ℝ)
        ≤ N0simple T (2 * T) := by
  rw [← Phi_four]
  exact n_point_bound 4 (2310/1000000:ℝ) 435 2500 (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) four_point_cert (by norm_num)

/-- **The same bound as a proportion.** -/
theorem four_point_bound_ratio :
    ∀ ε > 0, ∃ T₀ : ℝ, ∀ T ≥ T₀,
      (906250 * HD 1 - 1085) / 904171 - ε
        ≤ (N0simple T (2 * T) : ℝ) / (Ncount T (2 * T) : ℝ) := by
  intro ε hε
  obtain ⟨T₁, hT₁⟩ := four_point_bound ε hε
  obtain ⟨T₂, hT₂⟩ := eventually_atTop.mp eventually_Ncount_pos
  refine ⟨max T₁ T₂, fun T hT => ?_⟩
  have h1 := hT₁ T (le_trans (le_max_left _ _) hT)
  have h2 := hT₂ T (le_trans (le_max_right _ _) hT)
  rw [le_div_iff₀ h2]
  exact h1

