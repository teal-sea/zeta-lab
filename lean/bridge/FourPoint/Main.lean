namespace Zeta23Ext.Bridge.FourPoint

private lemma sum3 (f : Fin (4-1) → ℝ) : ∑ i, f i = f 0 + f 1 + f 2 := by
  show ∑ i : Fin 3, f i = f 0 + f 1 + f 2
  exact Fin.sum_univ_three f

/-- The four-point functional, written out.  The pair coefficient `2/(n − (j−i))` is
`2/3` on the three adjacent pairs, `1` on the two next-nearest pairs and `2` on the
outer pair. -/
lemma F4_eq (p : ℕ) (g : Fin 3 → ℝ) :
    F 4 p g = (1/(p:ℝ)) * (g 0 + g 1 + g 2)
      + 2/3 * wfun (g 0) + 2/3 * wfun (g 1) + 2/3 * wfun (g 2)
      + wfun (g 0 + g 1) + wfun (g 1 + g 2) + 2 * wfun (g 0 + g 1 + g 2) := by
  simp only [F, ptsN, sum3, Fin.sum_univ_four, Fin.isValue]
  norm_num
  -- `norm_num` evaluates the six pair coefficients `2/(4 − (j−i))` and cancels the
  -- telescoping `ptsN` differences; whether it also closes the goal depends on the
  -- association it leaves, so `ring` is optional rather than required.
  try ring

